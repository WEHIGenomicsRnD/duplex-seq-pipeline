nextflow_pipeline {

    name "Test the pipeline"
    script "main.nf"

    test("Test profile") {

        when {
            params {
                outdir = "$outputDir"
            }
        }

        then {
            assert workflow.success

            // mapped and consensus BAMs
            assert new File("$outputDir/mapped_bams/NanoMB1Rep1_mapped_merged.bam").exists()
            assert new File("$outputDir/consensus/NanoMB1Rep1_consensus_mapped_merged_filtered.bam").exists()

            // variant calling: the clipped consensus BAM, the nvc VCF and the filtered VCF; the test
            // data has no real variants, so the filtered VCF only has its header
            assert new File("$outputDir/consensus/NanoMB1Rep1_consensus_mapped_merged_filtered_clipped.bam").exists()
            def vcf = new File("$outputDir/variants/NanoMB1Rep1.vcf")
            assert vcf.exists()
            assert vcf.readLines().any { it.startsWith("##source=Naive Variant Caller") }
            def filtered_vcf = new File("$outputDir/variants/NanoMB1Rep1_filtered.vcf")
            assert filtered_vcf.exists()
            assert filtered_vcf.readLines().any { it.startsWith("##FORMAT=<ID=DP,") }

            // samtools flagstat reads the duplicate-marked BAM, so its duplicate count is Picard's
            def flagstat = new File("$outputDir/QC/samtools/flagstat/NanoMB1Rep1.flagstat").readLines()
            def flagstat_duplicates = flagstat.find { it.endsWith("primary duplicates") }.split(" ")[0] as int
            def markdup_file = new File("$outputDir/QC/mark_duplicates/NanoMB1Rep1_mapped_merged_markdup.metrics.txt")
            def markdup = markdup_file
                .readLines()
                .findAll { it.trim() && !it.startsWith("#") }
            def markdup_fields = markdup[0].split("\t").toList()
            def markdup_values = markdup[1].split("\t")
            def picard_duplicates = 2 * (markdup_values[markdup_fields.indexOf("READ_PAIR_DUPLICATES")] as double) +
                (markdup_values[markdup_fields.indexOf("UNPAIRED_READ_DUPLICATES")] as double)
            assert flagstat_duplicates > 0
            assert flagstat_duplicates == picard_duplicates
            // duplicates are marked per duplex molecule by default
            assert markdup_file.readLines().find { it.startsWith("# MarkDuplicates") }.contains("--DUPLEX_UMI true")

            // duplex metrics file in the format the duplex-multiqc plugin searches for
            def metrics = new File("$outputDir/QC/duplex_metrics/NanoMB1Rep1_metrics.csv")
            assert metrics.exists()
            assert metrics.readLines()[0] == "sample,metric,value"

            // the MultiQC report must contain the duplex section; MultiQC exits 0 without it when the
            // plugin is missing or broken, so look for the plugin's own output files
            def multiqc_data = new File("$outputDir/QC/multiqc/multiqc_data")
            assert multiqc_data.exists()
            assert multiqc_data.list().any { it.startsWith("duplex_seq") }
        }
    }

    test("Test profile with the read info table") {

        tag "read_info"

        when {
            params {
                outdir = "$outputDir"
                output_read_info = true
            }
        }

        then {
            assert workflow.success

            // the duplex metrics are computed from the read info table
            assert new File("$outputDir/QC/read_info/NanoMB1Rep1.txt.gz").exists()
            assert new File("$outputDir/QC/duplex_metrics/NanoMB1Rep1_metrics.csv").exists()

            def multiqc_data = new File("$outputDir/QC/multiqc/multiqc_data")
            assert multiqc_data.list().any { it.startsWith("duplex_seq") }
        }
    }

    test("Test profile with per-strand duplicate marking") {

        tag "legacy"

        when {
            params {
                outdir = "$outputDir"
                markdup_duplex_umi = false
            }
        }

        then {
            assert workflow.success

            // without --DUPLEX_UMI the two strands of a molecule are different molecules, as in Snakemake
            def markdup_file = new File("$outputDir/QC/mark_duplicates/NanoMB1Rep1_mapped_merged_markdup.metrics.txt")
            assert markdup_file.readLines().find { it.startsWith("# MarkDuplicates") }.contains("--DUPLEX_UMI false")
        }
    }

    test("Test profile with FastQ Screen") {

        tag "fastq_screen"

        when {
            params {
                outdir = "$outputDir"
                // the FastQ_Screen_Genomes folder made by tests/scripts/build_fastq_screen_db.sh, which the CI
                // workflow builds; run this test locally with FASTQ_SCREEN_DB set to that folder
                fastq_screen_db = System.getenv("FASTQ_SCREEN_DB")
            }
        }

        then {
            assert workflow.success

            // the E. coli reads hit the E. coli database that the script builds from the test reference
            ["R1", "R2"].each { read ->
                def screen = new File("$outputDir/QC/fastqscreen/NanoMB1Rep1_HJK2GDSX3_sampled_${read}_screen.txt")
                assert screen.exists()
                def row = screen.readLines().findAll { it.trim() && !it.startsWith("#") && !it.startsWith("%") }[1].split("\t")
                assert row[0] == "ecoli_atcc10798"
                assert (row[5] as double) > 95.0
            }

            // and the MultiQC report has a FastQ Screen section
            def multiqc_data = new File("$outputDir/QC/multiqc/multiqc_data")
            assert multiqc_data.list().any { it.startsWith("multiqc_fastq_screen") }
        }
    }
}
