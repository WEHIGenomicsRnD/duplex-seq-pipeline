/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    duplex-seq-pipeline base config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Generic labels, plus per-tool defaults taken from config/cluster.yaml of the
    Snakemake pipeline (release 0.1.0). Cap resources on small machines with process.resourceLimits.
*/

process {

    cpus = { 1 * task.attempt }
    memory = { 6.GB * task.attempt }
    time = { 4.h * task.attempt }

    errorStrategy = { task.exitStatus in ((130..145) + 104 + 175) ? 'retry' : 'finish' }
    maxRetries = 1
    maxErrors = '-1'

    withLabel: process_single {
        cpus = { 1 }
        memory = { 6.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    withLabel: process_low {
        cpus = { 2 * task.attempt }
        memory = { 12.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    withLabel: process_medium {
        cpus = { 6 * task.attempt }
        memory = { 36.GB * task.attempt }
        time = { 8.h * task.attempt }
    }
    withLabel: process_high {
        cpus = { 12 * task.attempt }
        memory = { 72.GB * task.attempt }
        time = { 16.h * task.attempt }
    }
    withLabel: process_long {
        time = { 20.h * task.attempt }
    }
    withLabel: process_high_memory {
        memory = { 200.GB * task.attempt }
    }
    withLabel: error_ignore {
        errorStrategy = 'ignore'
    }
    withLabel: error_retry {
        errorStrategy = 'retry'
        maxRetries = 2
    }

    // Per-tool resources (config/cluster.yaml of the Snakemake pipeline, release 0.1.0)
    withName: 'PICARD_.*|GATK4_.*' {
        cpus = { 1 }
        memory = { 96.GB * task.attempt }
        time = { 24.h * task.attempt }
    }
    withName: 'FGBIO_.*' {
        cpus = { 1 }
        memory = { 64.GB * task.attempt }
        time = { 12.h * task.attempt }
    }
    // the only multithreaded fgbio step here (--threads ${task.cpus}); listed after FGBIO_.* so it wins
    withName: FGBIO_CALLDUPLEXCONSENSUSREADS {
        cpus = { 4 }
        memory = { 16.GB * task.attempt }
    }
    // the entries below are listed after the PICARD_/GATK4_/FGBIO_ globs so they win. Retries double the memory.
    withName: 'GATK4_SAMTOFASTQ' {
        cpus = { 2 }
        memory = { 8.GB * task.attempt }
    }
    withName: 'GATK4_MERGEBAMALIGNMENT' {
        cpus = { 2 }
    }
    withName: PICARD_FASTQTOSAM {
        memory = { 32.GB * task.attempt }
    }
    withName: 'PICARD_SORTSAM.*' {
        memory = { 48.GB * task.attempt }
    }
    withName: 'FGBIO_EXTRACTUMISFROMBAM|FGBIO_CORRECTUMIS' {
        memory = { 16.GB * task.attempt }
    }
    withName: 'FGBIO_CLIPBAM|FGBIO_FILTERCONSENSUSREADS' {
        memory = { 32.GB * task.attempt }
    }
    // light: mosdepth gains nothing from more than a few decompression threads
    withName: MOSDEPTH {
        cpus = { 2 }
        memory = { 6.GB * task.attempt }
        time = { 4.h * task.attempt }
    }
    withName: NVC {
        cpus = { 1 }
        memory = { 8.GB * task.attempt }
        time = { 24.h * task.attempt }
    }
    withName: GET_READ_INFO {
        cpus = { 16 }
        memory = { 128.GB * task.attempt }
        time = { 24.h * task.attempt }
    }
    // used ~1.8 of 16 CPUs and 15 GB of 128 GB on the large samples
    withName: CALC_DUPLEX_METRICS {
        cpus = { 4 }
        memory = { 32.GB * task.attempt }
        time = { 24.h * task.attempt }
    }
    withName: BWA_MEM {
        cpus = { 16 }
        memory = { 24.GB * task.attempt }
        time = { 12.h * task.attempt }
    }
}
