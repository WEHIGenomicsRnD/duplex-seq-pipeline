/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
    Tool arguments that are hard-coded in the Snakemake pipeline are set here so they
    can be overridden.
*/

process {

    // ---- Reference preparation ----
    withName: PICARD_CREATESEQUENCEDICTIONARY {
        publishDir = [
            path: { "${params.outdir}/reference" },
            mode: params.publish_dir_mode,
            enabled: true,
        ]
    }

    withName: SAMTOOLS_FAIDX {
        publishDir = [
            path: { "${params.outdir}/reference" },
            mode: params.publish_dir_mode,
            enabled: true,
        ]
    }

    withName: BWA_INDEX {
        publishDir = [
            path: { "${params.outdir}/reference" },
            mode: params.publish_dir_mode,
            enabled: true,
        ]
    }

    // ---- FASTQ -> unmapped BAM with UMIs ----
    withName: PICARD_FASTQTOSAM {
        ext.args = { "--SAMPLE_NAME ${meta.id} --READ_GROUP_NAME ${meta.id}" }
        ext.prefix = { "${meta.id}_unmapped" }
    }

    withName: FGBIO_EXTRACTUMISFROMBAM {
        ext.args = { "--read-structure ${meta.read_structure} --molecular-index-tags ${params.molecular_index_tags} --single-tag ${params.single_tag}" }
        ext.prefix = { "${meta.id}_unmapped_uncorrected_wUMI" }
    }

    withName: FGBIO_CORRECTUMIS {
        ext.args = { "--max-mismatches ${params.max_mismatches} --min-distance ${params.min_distance} --umi-tag ${params.single_tag}" }
        ext.prefix = { "${meta.id}_unmapped_wUMI" }
    }

    // ---- Alignment ----
    // Snakemake runs `bwa mem -p -t N ref interleaved.fastq | samtools view -bS -`.
    // Add -K 150000000 to ext.args for thread-count independent output.
    withName: GATK4_SAMTOFASTQ {
        ext.prefix = { "${meta.id}" }
    }

    withName: BWA_MEM {
        ext.args = ''
        ext.args2 = '-b'
        ext.prefix = { "${meta.id}_mapped" }
    }

    withName: GATK4_MERGEBAMALIGNMENT {
        ext.args = '--SORT_ORDER coordinate --ALIGNER_PROPER_PAIR_FLAGS true --MAX_GAPS -1 --ORIENTATIONS FR'
        ext.prefix = { "${meta.id}_mapped_merged" }
        publishDir = [
            path: { "${params.outdir}/mapped_bams" },
            mode: params.publish_dir_mode,
            enabled: true,
        ]
    }

    withName: SAMTOOLS_INDEX {
        publishDir = [
            path: { "${params.outdir}/mapped_bams" },
            mode: params.publish_dir_mode,
            enabled: true,
        ]
    }

    // ---- Duplex consensus ----
    withName: FGBIO_GROUPREADSBYUMI {
        ext.args = { "--edits 1 --min-map-q ${params.min_mapq}" }
        ext.prefix = { "${meta.id}_grouped" }
        publishDir = [
            path: { "${params.outdir}/grouped_by_umi" },
            mode: params.publish_dir_mode,
            enabled: true,
        ]
    }

    withName: FGBIO_CALLDUPLEXCONSENSUSREADS {
        ext.args = { "--error-rate-pre-umi ${params.error_rate_pre_umi} --error-rate-post-umi ${params.error_rate_post_umi}" }
        ext.prefix = { "${meta.id}_consensus_unmapped" }
        publishDir = [
            path: { "${params.outdir}/consensus" },
            mode: params.publish_dir_mode,
            enabled: true,
        ]
    }

    withName: PICARD_SORTSAM {
        ext.prefix = { "${meta.id}_consensus_unmapped_queryname" }
    }

    withName: PICARD_SORTSAM_MAPPED {
        ext.prefix = { "${meta.id}_consensus_mapped_merged_queryname" }
    }

    // the consensus realignment reuses BAM_ALIGN; these selectors are later in the file than the
    // generic ones above, so they override the prefixes and publish location
    withName: '.*:BAM_ALIGN_CONSENSUS:GATK4_SAMTOFASTQ' {
        ext.prefix = { "${meta.id}_consensus" }
    }

    withName: '.*:BAM_ALIGN_CONSENSUS:BWA_MEM' {
        ext.prefix = { "${meta.id}_consensus_mapped" }
    }

    withName: '.*:BAM_ALIGN_CONSENSUS:GATK4_MERGEBAMALIGNMENT' {
        ext.prefix = { "${meta.id}_consensus_mapped_merged" }
        publishDir = [
            path: { "${params.outdir}/consensus" },
            mode: params.publish_dir_mode,
            enabled: true,
        ]
    }

    withName: '.*:BAM_ALIGN_CONSENSUS:SAMTOOLS_INDEX' {
        publishDir = [
            path: { "${params.outdir}/consensus" },
            mode: params.publish_dir_mode,
            enabled: true,
        ]
    }

    withName: FGBIO_FILTERCONSENSUSREADS {
        ext.args = { "--max-read-error-rate ${params.max_read_error_rate} --max-no-calls ${params.max_no_call_fraction} --sort-order Coordinate" }
        ext.prefix = { "${meta.id}_consensus_mapped_merged_filtered" }
        publishDir = [
            path: { "${params.outdir}/consensus" },
            mode: params.publish_dir_mode,
            enabled: true,
        ]
    }

    withName: SAMTOOLS_INDEX_FILTERED {
        publishDir = [
            path: { "${params.outdir}/consensus" },
            mode: params.publish_dir_mode,
            enabled: true,
        ]
    }

    // ---- QC ----
    withName: FASTQC {
        ext.args = '--quiet'
        publishDir = [
            path: { "${params.outdir}/QC/fastqc" },
            mode: params.publish_dir_mode,
            enabled: true,
        ]
    }

    withName: FASTQSCREEN {
        publishDir = [
            path: { "${params.outdir}/QC/fastqscreen" },
            mode: params.publish_dir_mode,
            enabled: true,
        ]
    }

    // the duplicate-marked BAM is not published, only the metrics (RX is the UMI tag)
    withName: PICARD_MARKDUPLICATES {
        ext.args = { "--BARCODE_TAG RX --MAX_RECORDS_IN_RAM ${params.markdup_max_records_in_ram}" }
        ext.prefix = { "${meta.id}_mapped_merged_markdup" }
        publishDir = [
            path: { "${params.outdir}/QC/mark_duplicates" },
            mode: params.publish_dir_mode,
            pattern: '*.metrics.txt',
            enabled: true,
        ]
    }

    withName: SAMTOOLS_STATS {
        publishDir = [
            path: { "${params.outdir}/QC/samtools/stats" },
            mode: params.publish_dir_mode,
            enabled: true,
        ]
    }

    withName: SAMTOOLS_FLAGSTAT {
        publishDir = [
            path: { "${params.outdir}/QC/samtools/flagstat" },
            mode: params.publish_dir_mode,
            enabled: true,
        ]
    }

    withName: QUALIMAP_BAMQC {
        publishDir = [
            path: { "${params.outdir}/QC/qualimap" },
            mode: params.publish_dir_mode,
            enabled: true,
        ]
    }

    // Snakemake passes only --metrics, --sort_mem and --bam_chunk_size (and --target_bed, --ref_fasta,
    // --cores in the module); add --rlen / --skips here to override the tool's defaults
    withName: CALC_DUPLEX_METRICS {
        ext.args = { "--metrics ${params.duplex_metrics} --sort_mem ${params.sort_mem} --bam_chunk_size ${params.bam_chunk_size}" }
        publishDir = [
            path: { "${params.outdir}/QC/duplex_metrics" },
            mode: params.publish_dir_mode,
            enabled: true,
        ]
    }

    withName: 'SAMTOOLS_STATS_CONSENSUS|SAMTOOLS_FLAGSTAT_CONSENSUS|QUALIMAP_BAMQC_CONSENSUS' {
        ext.prefix = { "${meta.id}_consensus" }
        publishDir = [
            path: { "${params.outdir}/QC/consensus" },
            mode: params.publish_dir_mode,
            enabled: true,
        ]
    }

    // MultiQC 1.35 plus the duplex-multiqc plugin; the container is built in the plugin repo and
    // the conda environment pins the same versions. Keep these two in sync with the plugin tag.
    withName: MULTIQC {
        container = 'ghcr.io/wehigenomicsrnd/duplex-multiqc:0.1.0'
        conda = "${projectDir}/assets/multiqc_duplex_environment.yml"
        ext.args = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        publishDir = [
            path: { "${params.outdir}/QC/multiqc" },
            mode: params.publish_dir_mode,
            enabled: true,
        ]
    }
}
