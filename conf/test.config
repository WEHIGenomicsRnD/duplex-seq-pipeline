/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Minimal test config
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    A 1 kb window (E. coli ATCC 10798, 2e914854fabb46b9_1:10001-11000) of NanoSeq data.
    Use with: nextflow run . -profile test,<docker|singularity|apptainer> --outdir <dir>
*/

process {
    resourceLimits = [
        cpus: 4,
        memory: '12.GB',
        time: '1.h',
    ]
}

params {
    input = "${projectDir}/tests/data/samplesheet.csv"
    fasta = "${projectDir}/tests/data/Escherichia_coli_ATCC_10798.fasta"

    // test data is a 1 kb window, so use small sort/chunk sizes
    sort_mem = '1G'
    bam_chunk_size = 100000
    read_info_buffer_size = '2G'
}
