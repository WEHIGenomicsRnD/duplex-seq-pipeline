config {
    // Test profile plus a container engine, for example:
    //   nf-test test --profile test,docker
    testsDir "tests"
    // not .nf-test: the launcher keeps nf-test.jar there, and `nf-test clean` removes the work dir
    workDir System.getenv("NFT_WORKDIR") ?: ".nf-test-work"
    configFile "tests/nextflow.config"
    profile "test"
}
