/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per-module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: 'copy',
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    // -----------------------------------------------------------------------
    //  Reference preparation
    // -----------------------------------------------------------------------
    withName: 'PICARD_CREATESEQUENCEDICTIONARY' {
        publishDir = [
            path: { "${params.outdir}/reference" },
            mode: 'copy'
        ]
    }

    withName: 'BWA_INDEX' {
        publishDir = [
            path: { "${params.outdir}/reference" },
            mode: 'copy'
        ]
    }

    // -----------------------------------------------------------------------
    //  Preprocessing
    // -----------------------------------------------------------------------
    withName: 'PICARD_FASTQTOSAM' {
        ext.args = 'SO=queryname'
        publishDir = [
            path: { "${params.outdir}/unmapped_bams" },
            mode: 'copy',
            enabled: false
        ]
    }

    withName: 'FGBIO_EXTRACT_UMIS' {
        publishDir = [
            path: { "${params.outdir}/unmapped_bams" },
            mode: 'copy',
            enabled: false
        ]
    }

    withName: 'FGBIO_CORRECT_UMIS' {
        publishDir = [
            path: { "${params.outdir}/unmapped_bams" },
            mode: 'copy',
            enabled: false
        ]
    }

    withName: 'PICARD_SAMTOFASTQ' {
        publishDir = [
            path: { "${params.outdir}/unmapped_bams" },
            mode: 'copy',
            enabled: false
        ]
    }

    withName: 'BWA_MEM' {
        ext.args = '-p'
        publishDir = [
            path: { "${params.outdir}/mapped_bams" },
            mode: 'copy',
            enabled: false
        ]
    }

    withName: 'PICARD_MERGEBAMALIGNMENT' {
        publishDir = [
            path: { "${params.outdir}/mapped_bams" },
            mode: 'copy',
            enabled: false
        ]
    }

    // -----------------------------------------------------------------------
    //  Consensus
    // -----------------------------------------------------------------------
    withName: 'FGBIO_GROUPREADSBYUMI' {
        publishDir = [
            path: { "${params.outdir}/grouped_by_umi" },
            mode: 'copy',
            enabled: false
        ]
    }

    withName: 'FGBIO_CALLDUPLEXCONSENSUSREADS' {
        publishDir = [
            path: { "${params.outdir}/consensus" },
            mode: 'copy',
            enabled: false
        ]
    }

    withName: 'PICARD_SAMTOFASTQ_CONSENSUS' {
        publishDir = [
            path: { "${params.outdir}/consensus" },
            mode: 'copy',
            enabled: false
        ]
    }

    withName: 'BWA_MEM_CONSENSUS' {
        ext.args = '-p'
        publishDir = [
            path: { "${params.outdir}/consensus" },
            mode: 'copy',
            enabled: false
        ]
    }

    withName: 'PICARD_MERGEBAMALIGNMENT_CONSENSUS' {
        publishDir = [
            path: { "${params.outdir}/consensus" },
            mode: 'copy',
            enabled: false
        ]
    }

    withName: 'FGBIO_FILTERCONSENSUSREADS' {
        publishDir = [
            path: { "${params.outdir}/consensus" },
            mode: 'copy',
            pattern: '*_filtered.bam'
        ]
    }

    // -----------------------------------------------------------------------
    //  QC — raw reads
    // -----------------------------------------------------------------------
    withName: 'FASTQC' {
        ext.args = '--quiet'
        publishDir = [
            path: { "${params.outdir}/QC/fastqc" },
            mode: 'copy'
        ]
    }

    withName: 'FASTQ_SCREEN' {
        publishDir = [
            path: { "${params.outdir}/QC/fastq_screen" },
            mode: 'copy'
        ]
    }

    withName: 'PICARD_MARKDUPLICATES' {
        publishDir = [
            path: { "${params.outdir}/QC/mark_duplicates" },
            mode: 'copy',
            pattern: '*.txt'
        ]
    }

    withName: 'SAMTOOLS_STATS' {
        publishDir = [
            path: { "${params.outdir}/QC/samtools/stats" },
            mode: 'copy'
        ]
    }

    withName: 'SAMTOOLS_FLAGSTAT' {
        publishDir = [
            path: { "${params.outdir}/QC/samtools/flagstat" },
            mode: 'copy'
        ]
    }

    withName: 'QUALIMAP_BAMQC' {
        publishDir = [
            path: { "${params.outdir}/QC/qualimap" },
            mode: 'copy'
        ]
    }

    withName: 'MULTIQC' {
        publishDir = [
            path: { "${params.outdir}/QC/multiqc" },
            mode: 'copy'
        ]
    }

    // -----------------------------------------------------------------------
    //  QC — consensus reads
    // -----------------------------------------------------------------------
    withName: 'SAMTOOLS_STATS_CONSENSUS' {
        publishDir = [
            path: { "${params.outdir}/QC/consensus/samtools/stats" },
            mode: 'copy'
        ]
    }

    withName: 'SAMTOOLS_FLAGSTAT_CONSENSUS' {
        publishDir = [
            path: { "${params.outdir}/QC/consensus/samtools/flagstat" },
            mode: 'copy'
        ]
    }

    withName: 'QUALIMAP_BAMQC_CONSENSUS' {
        publishDir = [
            path: { "${params.outdir}/QC/consensus/qualimap" },
            mode: 'copy'
        ]
    }

    withName: 'MULTIQC_CONSENSUS' {
        publishDir = [
            path: { "${params.outdir}/QC/consensus/multiqc" },
            mode: 'copy'
        ]
    }

    withName: 'GET_READ_INFO' {
        publishDir = [
            path: { "${params.outdir}/QC/read_info" },
            mode: 'copy',
            enabled: false
        ]
    }

    withName: 'FORMAT_READ_INFO' {
        publishDir = [
            path: { "${params.outdir}/QC/read_info" },
            mode: 'copy'
        ]
    }

    withName: 'CALC_DUPLEX_METRICS' {
        publishDir = [
            path: { "${params.outdir}/QC/duplex_metrics" },
            mode: 'copy'
        ]
    }

    // -----------------------------------------------------------------------
    //  Variant calling
    // -----------------------------------------------------------------------
    withName: 'FGBIO_CLIPBAM' {
        publishDir = [
            path: { "${params.outdir}/consensus" },
            mode: 'copy',
            enabled: false
        ]
    }

    withName: 'VARSCAN' {
        publishDir = [
            path: { "${params.outdir}/variants" },
            mode: 'copy'
        ]
    }

    withName: 'NVC' {
        publishDir = [
            path: { "${params.outdir}/variants" },
            mode: 'copy'
        ]
    }

    withName: 'FILTER_VCF' {
        publishDir = [
            path: { "${params.outdir}/variants" },
            mode: 'copy'
        ]
    }
}
