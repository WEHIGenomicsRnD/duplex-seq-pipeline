/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Duplex Sequencing Pipeline - Nextflow Configuration
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Converted from Snakemake duplex-seq-pipeline
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
*/

params {
    // -------------------------
    // Input / Output
    // -------------------------
    input                   = null   // Path to samplesheet CSV
    outdir                  = 'results'
    ref                     = null   // Reference genome FASTA

    // -------------------------
    // FastqScreen
    // -------------------------
    fastq_screen_config     = null   // Path to fastq_screen.conf

    // -------------------------
    // MultiQC
    // -------------------------
    multiqc_config          = null   // Path to multiqc_config.yaml

    // -------------------------
    // UMI handling
    // -------------------------
    umis                    = ''     // File of UMI sequences (empty = no correction)
    max_mismatches          = 3      // Max UMI mismatches for correction
    min_distance            = 1      // Min distance to next best UMI

    // fgbio ExtractUmisFromBam
    read_structure          = '3M2S146T 3M2S146T'
    molecular_index_tags    = 'ZA ZB'
    single_tag              = 'RX'

    // -------------------------
    // Alignment
    // -------------------------
    min_mapq                = 20     // Min mapping quality (GroupReadsByUmi)

    // -------------------------
    // Duplex consensus calling (fgbio CallDuplexConsensusReads)
    // -------------------------
    min_input_baseq         = 30
    error_rate_pre_umi      = 45
    error_rate_post_umi     = 40

    // -------------------------
    // Consensus filtering (fgbio FilterConsensusReads)
    // -------------------------
    min_reads               = '4 2 2'
    max_read_error_rate     = 0.05
    max_base_error_rate     = 0.1
    min_base_quality        = 50
    max_no_call_fraction    = 0.05

    // -------------------------
    // Duplex metrics
    // -------------------------
    duplex_metrics          = 'all'

    // -------------------------
    // Variant calling
    // -------------------------
    variant_caller          = 'nvc'  // 'nvc' or 'varscan'

    // VarScan / shared
    min_coverage            = 4
    min_reads2              = 2
    min_vaf                 = 0.01

    // NVC-specific
    ploidy                  = 1

    // -------------------------
    // Boilerplate
    // -------------------------
    help                    = false
    max_memory              = '128.GB'
    max_cpus                = 16
    max_time                = '48.h'
}

// Load module-specific configuration
includeConfig 'conf/modules.config'

profiles {
    conda {
        conda.enabled = true
        docker.enabled = false
        singularity.enabled = false
    }
    docker {
        docker.enabled = true
        conda.enabled = false
        singularity.enabled = false
        docker.runOptions = '-u $(id -u):$(id -g)'
    }
    singularity {
        singularity.enabled = true
        singularity.autoMounts = true
        conda.enabled = false
        docker.enabled = false
    }
    test {
        params.max_cpus   = 2
        params.max_memory = '6.GB'
        params.max_time   = '6.h'
    }
}

// Capture exit codes from upstream processes when piping
process.shell = ['/bin/bash', '-euo', 'pipefail']

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace.txt"
    fields  = 'task_id,hash,native_id,process,tag,name,status,exit,module,container,cpus,time,disk,memory,attempt,submit,start,complete,duration,realtime,queue,%cpu,%mem,rss,vmem,peak_rss,peak_vmem,rchar,wchar,syscr,syscw,read_bytes,write_bytes,vol_ctxt,inv_ctxt,env,workdir,script,scratch,error_action'
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag.html"
}

manifest {
    name            = 'duplex-seq-pipeline'
    author          = 'Marek Cmero'
    description     = 'Duplex sequencing pipeline for consensus calling, QC and variant detection'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=24.04.0'
    version         = '1.0.0'
}

// Resource limits are enforced via process labels in conf/modules.config
// and the params.max_* values above.
